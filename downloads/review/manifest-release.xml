<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="2"
    android:versionName="1.0.1"
    android:compileSdkVersion="35"
    android:compileSdkVersionCodename="15"
    package="br.com.desbloqueia"
    platformBuildVersionCode="35"
    platformBuildVersionName="15">

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission
        android:name="android.permission.VIBRATE" />

    <permission
        android:name="br.com.desbloqueia.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="0x2" />

    <uses-permission
        android:name="br.com.desbloqueia.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:theme="@ref/0x7f0a0000"
        android:label="Desbloqueia · Concursos"
        android:icon="@ref/0x7f040006"
        android:name="br.com.desbloqueia.StudyApplication"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:extractNativeLibs="false"
        android:fullBackupContent="@ref/0x7f0c0000"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@ref/0x7f0c0001">

        <activity
            android:name="br.com.desbloqueia.MainActivity"
            android:exported="true"
            android:launchMode="1">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
